<style>
  .logo-wrapper {
    position: relative;
    width: 150px;
    height: 230px;
    margin: auto;
  }

  .logo-stroke,
  .logo-full {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
  }

  .logo-stroke {
    z-index: 1;
  }

  .logo-full {
    z-index: 2;
    opacity: 0;
    animation:
      fadeIn 0.8s ease-in-out 1.5s forwards,
      pulse 2s ease-in-out 2.4s infinite;
  }

  .trace-anime {
    stroke-dasharray: 3000;
    stroke-dashoffset: 3000;
    animation: draw 2s ease-in-out forwards;
  }

  .cls-1 {
    fill: #fff;
  }

  .cls-2 {
    fill: var(--accent-regular);
  }

  .cls-3 {
    fill: none;
    stroke: #000;
    stroke-miterlimit: 10;
    stroke-width: 19.41px;
  }

  .cls-4 {
    stroke-linecap: round;
    fill: none;
    stroke: var(--gray-0);
    stroke-miterlimit: 10;
    stroke-width: 19.41px;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.05);
      opacity: 0.9;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>
