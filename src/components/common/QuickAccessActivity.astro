---
import Icon from "./Icon.astro";

export interface Props {
  i18n: any;
  lang: "fr" | "en";
}

const { i18n, lang } = Astro.props as Props;
---

<script is:inline>
  (() => {
    const root = document.getElementById("quick-access-menu");
    const listEl = root?.querySelector("[data-gh-list]");
    const user = "Jamedie";

    const cacheKey = `gh:events:${user}`;
    const etagKey = `gh:etag:${user}`;

    const render = (items) => {
      if (!listEl) return;
      if (!items?.length) {
        listEl.innerHTML = '<p class="qa-muted">Aucune activité récente.</p>';
        return;
      }
      listEl.innerHTML = items
        .slice(0, 10)
        .map((ev) => {
          const repo = ev.repo?.name ?? user;
          const when = new Date(ev.created_at);
          const rel = new Intl.RelativeTimeFormat("fr", { numeric: "auto" });
          const mins = Math.floor((Date.now() - when.getTime()) / 60000);
          const human =
            mins < 60
              ? rel.format(-mins, "minute")
              : mins < 1440
                ? rel.format(-Math.floor(mins / 60), "hour")
                : rel.format(-Math.floor(mins / 1440), "day");
          const label =
            ev.type === "PushEvent"
              ? `${ev.payload?.commits?.length ?? 1} commit${(ev.payload?.commits?.length ?? 1) > 1 ? "s" : ""} → ${repo}`
              : ev.type === "PullRequestEvent"
                ? `PR #${ev.payload?.pull_request?.number ?? "?"} ${ev.payload?.action ?? ""} → ${repo}`
                : ev.type === "CreateEvent"
                  ? `Création ${ev.payload?.ref_type ?? ""} ${ev.payload?.ref ?? ""} → ${repo}`
                  : ev.type === "WatchEvent"
                    ? `★ ${repo}`
                    : `${ev.type} → ${repo}`;
          return `<a class="gh-item" href="https://github.com/${repo}" target="_blank" rel="noopener">
                <span class="gh-label">${label}</span>
                <span class="gh-meta">${human}</span>
              </a>`;
        })
        .join("");
    };

    const loadFromCache = () => {
      try {
        const raw = localStorage.getItem(cacheKey);
        if (!raw) return null;
        const { ts, data } = JSON.parse(raw);
        if (Date.now() - ts < 5 * 60 * 1000) return data; // 5 min
        return null;
      } catch {
        return null;
      }
    };

    const saveCache = (data) => {
      localStorage.setItem(cacheKey, JSON.stringify({ ts: Date.now(), data }));
    };

    const fetchEvents = async () => {
      if (!listEl) return;
      listEl.innerHTML = '<p class="qa-muted">Chargement…</p>';

      const headers = {};
      const etag = localStorage.getItem(etagKey);
      if (etag) headers["If-None-Match"] = etag;

      try {
        const res = await fetch(
          `https://api.github.com/users/${user}/events/public`,
          { headers }
        );
        if (res.status === 304) {
          const cached = loadFromCache();
          if (cached) render(cached);
          return;
        }
        if (!res.ok) throw new Error(`GitHub: ${res.status}`);
        const data = await res.json();
        const newEtag = res.headers.get("etag");
        if (newEtag) localStorage.setItem(etagKey, newEtag);
        saveCache(data);
        render(data);
      } catch (e) {
        listEl.innerHTML = `<p class="qa-error">${e.message || "Erreur de chargement"}</p>`;
      }
    };

    // 1) Affiche le cache instantanément si présent
    const cached = loadFromCache();
    if (cached) render(cached);

    // 2) Ne fetch QUE quand le menu s’ouvre
    new MutationObserver(() => {
      if (root?.getAttribute("data-open") === "1") fetchEvents();
    }).observe(root, { attributes: true, attributeFilter: ["data-open"] });

    console.log("Quick access menu loaded with " + user + " activities.");
  })();
</script>

<section
  class={`qa-activities-container`}
  role="group"
  aria-label="Activités récentes"
>
  <div class="qa-activities-container">
    <h4 class="no-select">{i18n.quickAccess.activities}</h4>
    <div class="gh-list" data-gh-list></div>
  </div>
</section>

<style>
  .qa-activities-container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .gh-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .gh-item {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    text-decoration: none;
    color: inherit;
  }
  .gh-item:hover {
    background: color-mix(in srgb, var(--color-surface) 96%, transparent);
  }
  .gh-label {
    font-size: 0.9rem;
    font-weight: 500;
  }
  .gh-meta {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }
  .qa-muted {
    color: var(--color-text-secondary);
  }
  .qa-error {
    color: #ef4444;
  }
</style>
