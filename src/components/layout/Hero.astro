---
import { Image } from "astro:assets";
import avatar from "../../assets/images/hero-image.webp"; // depuis src/components/layout/Hero.astro
export interface Props {
  i18n: any;
  lang: "fr" | "en";
}
const { i18n } = Astro.props;
---

<section class="hero">
  <div class="container">
    <div class="col left">
      <p class="greeting">{i18n.hero.greeting}</p>
      <h1 class="title">
        <span class="light">{"im" in i18n.hero ? i18n.hero.im : ""}</span>
        <span class="name">{i18n.hero.name}</span>
      </h1>
      <p class="subtitle">{i18n.hero.role_description}</p>

      <div class="actions">
        <a class="btn primary" href={i18n.hero.cta_contact_href} rel="noopener">
          {i18n.hero.cta_contact}
        </a>
        <a
          class="btn ghost"
          href={i18n.hero.cta_resume_href}
          rel="noopener"
          target="_blank"
        >
          {i18n.hero.cta_resume}
        </a>
      </div>
    </div>

    <div class="col right">
      <div class="hero-avatar">
        <div class="gradient-bg"></div>
        <Image
          src={avatar}
          alt="Portrait de Jimmy Gaucher"
          widths={[240, 320, 400]}
          sizes="(max-width: 900px) 70vw, 380px"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh; /* occupe toute la hauteur de l'écran */
    display: flex;
    align-items: center; /* centre verticalement */
    padding: clamp(3rem, 6vw, 6rem) 0;
    background: var(--color-background);
  }

  .container {
    max-width: var(--container-max-width, 1100px);
    margin: 0 auto;
    padding: 0 var(--spacing-4, 1rem);
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .greeting {
    color: var(--color-text-secondary);
    margin: 0 0 0.25rem;
  }
  .title {
    margin: 0 0 0.75rem;
    font-weight: 800;
    font-size: clamp(2.2rem, 6vw, 4rem);
    line-height: 1.05;
  }
  .light {
    font-weight: 600;
    opacity: 0.8;
    margin-right: 0.35ch;
  }
  .name {
    background: linear-gradient(
      90deg,
      var(--color-accent) 0%,
      var(--color-text) 60%
    );
    -webkit-background-clip: text;
    background-clip: text;
  }
  .subtitle {
    margin: 0 0 1.25rem;
    color: var(--color-text-secondary);
    max-width: 50ch;
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn.ghost {
    background: transparent;
    border-color: var(--color-border, rgba(127, 127, 127, 0.25));
    color: var(--color-text);
  }
  .btn.ghost:hover {
    background: rgba(127, 127, 127, 0.08);
  }

  .right {
    display: flex;
    justify-content: center;
  }

  .hero-avatar {
    position: relative;
    width: 380px;
    aspect-ratio: 3 / 4;
    border-radius: 9999px;
    overflow: hidden;
  }

  .hero-avatar .gradient-bg {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--accent-regular) 50%, transparent) 0%,
      transparent 100%
    );
  }

  :global(.theme-dark) .hero-avatar .gradient-bg {
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--accent-regular) 40%, transparent) 0%,
      transparent 100%
    );
  }

  /* l’image */
  .hero-avatar img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: scale-down;
  }

  @media (max-width: 900px) {
    .container {
      grid-template-columns: 1fr;
    }
    .right {
      order: -1;
    }
    .avatar {
      width: min(280px, 70vw);
      margin: 0 auto 1rem;
    }
  }
</style>
