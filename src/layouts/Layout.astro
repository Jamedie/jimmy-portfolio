---
// src/layouts/Layout.astro
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import IntroScreen from "@/components/intro/IntroScreen.astro";
import SEO from "@/components/common/SEO.astro";

// Importer les styles globaux
import "@/styles/global.css";

// 1. Déclarer les props attendues (title et lang)
export interface Props {
  i18n: any;
  lang: "fr" | "en";
}
const { i18n, lang } = Astro.props;
const isHome = /^\/(fr|en)\/?$/.test(Astro.url.pathname);
const pageKey = Astro.url.pathname.includes("/projets") ? "projects" : "home";
const meta = i18n[pageKey] || i18n.home;
---

<html lang={lang}>
  <head>
    <SEO title={meta.title} description={meta.description} lang={lang} />
  </head>

  <body>
    {isHome && <IntroScreen />}

    <Header i18n={i18n} lang={lang} />

    <main>
      <slot />
    </main>

    <Footer i18n={i18n} lang={lang} />
  </body>
</html>
