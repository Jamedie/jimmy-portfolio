---
// src/layouts/BaseLayout.astro
import IntroScreen from "../components/IntroScreen.astro";

// Import global styles
// import "../styles/fonts.css";
import "../styles/global.css";

const { url } = Astro;
const isHome = url.pathname === "/";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body>
    {isHome && <IntroScreen />}
    <main>
      <slot />
      <!-- Here will be the page-specific content -->
      <h1>Hello World in h1</h1>
      <h2>Hello World but h2</h2>
      <h3>Hello World but h3</h3>
      <h4>Hello World but h4</h4>
      <h5>Hello World but h5</h5>
      <p>Hello World but p</p>

      <button class="btn btn--primary">Contactez-moi</button>

      <a href="/projets" class="btn btn--secondary">Voir mes projets</a>
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
