---
import { Image } from "astro:assets";
import avatarShrug from "../assets/images/404-image.png";
import "@/styles/global.css";
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width">
		<meta name="robots" content="noindex">
		<title>Page introuvable | Jimmy Gaucher</title>
		<script is:inline>
		const theme = localStorage.getItem("theme");
		if (theme === "dark" || (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
			document.documentElement.classList.add("theme-dark");
		}
		</script>
	</head>
	<body>
		<main class="not-found">
			<figure class="avatar-capsule" aria-hidden="true">
				<div class="avatar-capsule__gradient"></div>
				<Image
					class="avatar-capsule__image"
					src={avatarShrug}
					alt=""
					widths={[320, 448, 512]}
					sizes="(max-width: 900px) min(28rem, 100vw), min(32rem, 42vw)"
					loading="eager"
					decoding="async"
				/>
			</figure>
			<section class="not-found__copy">
				<p class="code">404</p>
				<h1 data-fr="Page introuvable" data-en="Page not found">Page introuvable</h1>
				<p
					class="message"
					data-fr="La page que vous recherchez n’existe pas ou a été déplacée."
					data-en="The page you are looking for does not exist or has been moved."
				>
					La page que vous recherchez n’existe pas ou a été déplacée.
				</p>
				<a
					id="home-link"
					class="btn btn--primary"
					href="/fr"
					data-fr="Retour à l’accueil"
					data-en="Back to home"
					>Retour à l’accueil</a
				>
			</section>
		</main>
		<script is:inline>
		const pathLanguage = window.location.pathname.split("/")[1];
		const browserLanguages = navigator.languages?.length
			? navigator.languages
			: [navigator.language];
		const browserLanguage = browserLanguages
			.map((value) => value?.toLowerCase().split("-")[0])
			.find((value) => value === "fr" || value === "en");
		const language =
			pathLanguage === "fr" || pathLanguage === "en" ? pathLanguage : (browserLanguage ?? "fr");
		document.documentElement.lang = language;
		document.title =
			language === "en" ? "Page not found | Jimmy Gaucher" : "Page introuvable | Jimmy Gaucher";
		document.querySelectorAll("[data-fr][data-en]").forEach((element) => {
			element.textContent = element.dataset[language];
		});
		document.querySelector("#home-link").href = `/${language}`;
		</script>
	</body>
</html>

<style>
.not-found {
	min-height: 100vh;
	display: grid;
	grid-template-columns: minmax(18rem, 32rem) minmax(18rem, 32rem);
	align-items: center;
	justify-content: center;
	gap: clamp(1rem, 4vw, 5rem);
	padding: var(--spacing-8);
}
.not-found__copy {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: var(--spacing-4);
}
.code {
	color: var(--accent-regular);
	font-family: var(--font-brand);
	font-size: clamp(5rem, 20vw, 10rem);
	font-weight: 700;
	line-height: 0.8;
}
h1 {
	font-size: clamp(2rem, 6vw, 3.5rem);
}
.message {
	max-width: 36rem;
	margin-bottom: var(--spacing-4);
	font-size: var(--text-lg);
}
.avatar-capsule {
	position: relative;
	width: min(32rem, 42vw);
	aspect-ratio: 3 / 4;
	border-radius: 9999px;
	margin: 0;
}

.avatar-capsule__gradient {
	position: absolute;
	inset: 0;
	border-radius: inherit;
	background: radial-gradient(circle at 50% 35%, #4d421d 0%, #241f12 58%, #12130f 100%);
}

.avatar-capsule__image {
	position: relative;
	z-index: 1;
	display: block;
	width: 100%;
	height: 100%;
	object-fit: scale-down;
}
@media (max-width: 900px) {
	.not-found {
		grid-template-columns: 1fr;
		padding-bottom: 0;
		text-align: center;
	}
	.not-found__copy {
		align-items: center;
	}
	.avatar-capsule {
		width: min(28rem, 100%);
		margin-inline: auto;
	}
}
</style>
